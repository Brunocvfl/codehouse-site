---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { whatsappLink } from '../lib/whatsapp';
---
<Base title="Página não encontrada">
  <section class="wrap grid min-h-[60vh] content-center pb-20 pt-32">
    <p class="font-mono text-codigo">{'{ 404 }'}</p>
    <h1 class="mt-3 text-3xl font-semibold md:text-4xl" >Esta página não existe.</h1>
    <p class="mt-4 max-w-lg text-nevoa-2">O endereço pode ter mudado ou foi digitado com algum erro. Volte para o início ou fale com a gente.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-linha">Voltar ao início</a>
      <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-acao"><Icon name="whatsapp" size={20} /> Falar no WhatsApp</a>
    </div>
  </section>
</Base>
