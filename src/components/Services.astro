---
import { whatsappLink } from '../lib/whatsapp';

const servicos = [
  {
    id: 'institucional',
    nome: 'Sites institucionais',
    resumo: 'A presença oficial da sua empresa',
    descricao:
      'Quem vocês são, o que fazem e como falar com vocês, num site que passa confiança e aparece no Google.',
    recebe: ['Domínio e hospedagem configurados', 'Layout próprio, adaptado ao celular', 'SEO básico e Google Analytics'],
    assunto: 'Quero um site institucional para o meu negócio.',
  },
  {
    id: 'landing',
    nome: 'Landing pages',
    resumo: 'Uma oferta, uma ação, alta conversão',
    descricao:
      'Uma página focada em vender, captar contatos ou agendar. Cada bloco existe para levar o visitante até o botão.',
    recebe: ['Texto orientado à conversão', 'Carregamento rápido no celular', 'WhatsApp, pixel e analytics integrados'],
    assunto: 'Quero uma landing page para uma oferta.',
  },
  {
    id: 'sistemas',
    nome: 'Sistemas web',
    resumo: 'Sob medida para a sua operação',
    descricao:
      'Painéis, cadastros, agendamentos, pedidos e relatórios que substituem planilhas e processos manuais.',
    recebe: ['Login com níveis de acesso', 'Banco de dados e backups', 'Relatórios e exportação'],
    assunto: 'Preciso de um sistema web sob medida.',
  },
  {
    id: 'aplicacoes',
    nome: 'Aplicações completas',
    resumo: 'Do protótipo ao produto no ar',
    descricao:
      'Front-end, back-end, integrações e infraestrutura para lançar uma plataforma, um SaaS ou um app web.',
    recebe: ['Arquitetura pronta para crescer', 'Pagamentos, e-mail e APIs', 'Deploy, monitoramento e suporte'],
    assunto: 'Quero tirar uma aplicação do papel.',
  },
];
---
<section id="servicos" class="relative border-t border-linha py-24 md:py-32" aria-labelledby="servicos-titulo">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 id="servicos-titulo" class="titulo-secao lg:col-span-7">O que construímos</h2>
      <p class="text-lg text-nevoa-2 lg:col-span-5">
        Escolha um formato e veja a planta do que entregamos. Todos com código limpo, páginas rápidas e visual que ajuda o cliente a decidir.
      </p>
    </div>

    <div class="servicos mt-14 grid grid-cols-1 overflow-hidden rounded-2xl border border-linha bg-noite-2 lg:grid-cols-12" data-servicos>
      <div role="tablist" aria-label="Serviços" aria-orientation="vertical" class="abas flex min-w-0 gap-px overflow-x-auto [scrollbar-width:none] border-b border-linha lg:col-span-4 lg:flex-col lg:overflow-visible lg:border-b-0 lg:border-r">
        {servicos.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`aba-${s.id}`}
            aria-controls={`painel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="aba"
          >
            <span class="aba-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="flex flex-col items-start text-left">
              <span class="aba-nome">{s.nome}</span>
              <span class="aba-resumo">{s.resumo}</span>
            </span>
          </button>
        ))}
      </div>

      <div class="relative lg:col-span-8">
        {servicos.map((s, i) => (
          <div
            role="tabpanel"
            id={`painel-${s.id}`}
            aria-labelledby={`aba-${s.id}`}
            class="painel grid gap-8 p-6 md:p-10 xl:grid-cols-[1.25fr_1fr]"
            hidden={i !== 0}
          >
            <div class="planta malha" aria-hidden="true">
              <svg viewBox="0 0 400 280" class="w-full">
                {s.id === 'institucional' && (
                  <g>
                    <rect class="traco" pathLength="1" x="20" y="16" width="360" height="248" rx="8" />
                    <line class="traco" pathLength="1" x1="20" y1="40" x2="380" y2="40" />
                    <circle class="ponto" cx="34" cy="28" r="3" /><circle class="ponto" cx="46" cy="28" r="3" /><circle class="ponto" cx="58" cy="28" r="3" />
                    <rect class="traco" pathLength="1" x="36" y="54" width="48" height="10" rx="2" />
                    <line class="traco" pathLength="1" x1="240" y1="59" x2="270" y2="59" /><line class="traco" pathLength="1" x1="282" y1="59" x2="312" y2="59" /><line class="traco" pathLength="1" x1="324" y1="59" x2="362" y2="59" />
                    <rect class="traco preenche" pathLength="1" x="36" y="80" width="328" height="78" rx="4" />
                    <line class="traco forte" pathLength="1" x1="56" y1="106" x2="230" y2="106" />
                    <line class="traco forte" pathLength="1" x1="56" y1="122" x2="190" y2="122" />
                    <rect class="acao" x="56" y="134" width="64" height="14" rx="3" />
                    <rect class="traco" pathLength="1" x="36" y="172" width="100" height="72" rx="4" />
                    <rect class="traco" pathLength="1" x="150" y="172" width="100" height="72" rx="4" />
                    <rect class="traco" pathLength="1" x="264" y="172" width="100" height="72" rx="4" />
                  </g>
                )}
                {s.id === 'landing' && (
                  <g>
                    <rect class="traco" pathLength="1" x="110" y="8" width="180" height="264" rx="10" />
                    <line class="traco forte" pathLength="1" x1="130" y1="40" x2="270" y2="40" />
                    <line class="traco forte" pathLength="1" x1="130" y1="54" x2="240" y2="54" />
                    <line class="traco" pathLength="1" x1="130" y1="70" x2="250" y2="70" />
                    <rect class="acao" x="130" y="82" width="140" height="18" rx="4" />
                    <circle class="traco" pathLength="1" cx="138" cy="124" r="5" /><line class="traco" pathLength="1" x1="150" y1="124" x2="250" y2="124" />
                    <circle class="traco" pathLength="1" cx="138" cy="142" r="5" /><line class="traco" pathLength="1" x1="150" y1="142" x2="236" y2="142" />
                    <circle class="traco" pathLength="1" cx="138" cy="160" r="5" /><line class="traco" pathLength="1" x1="150" y1="160" x2="244" y2="160" />
                    <rect class="traco" pathLength="1" x="130" y="182" width="140" height="14" rx="3" />
                    <rect class="traco" pathLength="1" x="130" y="202" width="140" height="14" rx="3" />
                    <rect class="acao" x="130" y="226" width="140" height="18" rx="4" />
                    <path class="traco guia" pathLength="1" d="M300 91 H340 V235 H300" />
                    <text class="cota" x="346" y="166">1 ação</text>
                  </g>
                )}
                {s.id === 'sistemas' && (
                  <g>
                    <rect class="traco" pathLength="1" x="12" y="14" width="376" height="252" rx="8" />
                    <line class="traco" pathLength="1" x1="92" y1="14" x2="92" y2="266" />
                    <line class="traco" pathLength="1" x1="28" y1="40" x2="74" y2="40" /><line class="traco" pathLength="1" x1="28" y1="60" x2="68" y2="60" /><line class="traco" pathLength="1" x1="28" y1="80" x2="72" y2="80" /><line class="traco" pathLength="1" x1="28" y1="100" x2="62" y2="100" />
                    <rect class="traco" pathLength="1" x="106" y="28" width="82" height="44" rx="4" />
                    <rect class="traco" pathLength="1" x="198" y="28" width="82" height="44" rx="4" />
                    <rect class="traco" pathLength="1" x="290" y="28" width="84" height="44" rx="4" />
                    <polyline class="traco forte" pathLength="1" points="110,150 150,128 190,138 230,104 270,116 310,90 370,98" />
                    <line class="traco" pathLength="1" x1="106" y1="160" x2="374" y2="160" />
                    <line class="traco" pathLength="1" x1="106" y1="184" x2="374" y2="184" />
                    <line class="traco" pathLength="1" x1="106" y1="206" x2="374" y2="206" />
                    <line class="traco" pathLength="1" x1="106" y1="228" x2="374" y2="228" />
                    <line class="traco" pathLength="1" x1="106" y1="250" x2="374" y2="250" />
                    <rect class="acao" x="334" y="190" width="40" height="10" rx="2" />
                  </g>
                )}
                {s.id === 'aplicacoes' && (
                  <g>
                    <rect class="traco" pathLength="1" x="18" y="40" width="96" height="64" rx="5" />
                    <line class="traco" pathLength="1" x1="8" y1="112" x2="124" y2="112" />
                    <rect class="traco" pathLength="1" x="46" y="160" width="40" height="72" rx="7" />
                    <rect class="traco forte" pathLength="1" x="166" y="104" width="86" height="72" rx="6" />
                    <text class="cota" x="192" y="145">API</text>
                    <path class="traco guia" pathLength="1" d="M124 74 C150 74 140 128 166 128" />
                    <path class="traco guia" pathLength="1" d="M86 196 C130 196 136 152 166 152" />
                    <path class="traco" pathLength="1" d="M300 52 a28 8 0 0 0 56 0 a28 8 0 0 0 -56 0 v40 a28 8 0 0 0 56 0 v-40" />
                    <text class="cota" x="313" y="122">dados</text>
                    <rect class="traco" pathLength="1" x="284" y="150" width="90" height="30" rx="5" />
                    <text class="cota" x="293" y="169">pagamentos</text>
                    <rect class="traco" pathLength="1" x="284" y="196" width="90" height="30" rx="5" />
                    <text class="cota" x="309" y="215">e-mail</text>
                    <path class="traco guia" pathLength="1" d="M252 116 C276 116 276 76 300 76" />
                    <path class="traco guia" pathLength="1" d="M252 150 H284" />
                    <path class="traco guia" pathLength="1" d="M252 164 C268 164 266 211 284 211" />
                    <circle class="acao" cx="209" cy="104" r="4" />
                  </g>
                )}
              </svg>
            </div>

            <div class="flex flex-col">
              <h3 class="text-2xl font-semibold">{s.nome}</h3>
              <p class="mt-3 text-nevoa-2">{s.descricao}</p>
              <p class="mt-6 text-sm font-medium">Você recebe</p>
              <ul class="mt-2 space-y-2 text-sm text-nevoa-2">
                {s.recebe.map((r) => (
                  <li class="flex items-start gap-2.5">
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="mt-0.5 shrink-0 text-codigo"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    {r}
                  </li>
                ))}
              </ul>
              <a href={whatsappLink(s.assunto)} target="_blank" rel="noopener" class="link-codigo mt-auto pt-8 text-sm">
                Pedir orçamento de {s.nome.toLowerCase()}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .aba {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    min-width: 15rem;
    padding: 1.25rem 1.4rem;
    background: var(--color-noite-2);
    color: var(--color-nevoa-2);
    cursor: pointer;
    position: relative;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  @media (min-width: 1024px) {
    .aba { min-width: 0; padding: 1.6rem 1.75rem; border-bottom: 1px solid var(--color-linha); }
  }
  .aba:hover { background: var(--color-noite-3); color: var(--color-nevoa); }
  .aba[aria-selected='true'] { background: var(--color-noite-3); color: var(--color-nevoa); }
  .aba[aria-selected='true']::before {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0; height: 2px;
    background: linear-gradient(90deg, var(--color-codigo), var(--color-telhado));
  }
  @media (min-width: 1024px) {
    .aba[aria-selected='true']::before { top: 0; bottom: 0; right: auto; width: 3px; height: auto; background: linear-gradient(180deg, var(--color-codigo), var(--color-telhado)); }
  }
  .aba-num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-codigo); padding-top: 0.2rem; }
  .aba-nome { font-family: var(--font-display); font-size: 1.05rem; font-weight: 500; line-height: 1.25; }
  .aba-resumo { margin-top: 0.3rem; font-size: 0.875rem; color: var(--color-nevoa-2); }

  .planta { border: 1px solid var(--color-linha); border-radius: 12px; padding: 1rem; background-color: var(--color-noite-painel); }
  .traco { fill: none; stroke: var(--color-codigo); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; opacity: 0.75; }
  .traco.forte { stroke: var(--color-nevoa); stroke-width: 3; opacity: 0.9; }
  .traco.guia { stroke: var(--color-telhado-claro); stroke-dasharray: 4 5; }
  .traco.preenche { fill: color-mix(in srgb, var(--color-telhado) 12%, transparent); }
  .ponto { fill: var(--color-linha-forte); }
  .acao { fill: var(--color-chaves); }
  .cota { font-family: var(--font-mono); font-size: 11px; fill: var(--color-nevoa-2); }

  /* Ao abrir um painel, a planta é desenhada (resposta à ação do usuário) */
  .painel.desenha .traco:not(.guia) { stroke-dasharray: 1; animation: desenhar 1.1s cubic-bezier(.6,0,.2,1) both; }
  .painel.desenha .acao, .painel.desenha .cota { animation: surgir 0.4s 0.8s both; }
  @keyframes desenhar { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes surgir { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .painel.desenha .traco, .painel.desenha .acao, .painel.desenha .cota { animation: none; }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-servicos]');
  if (raiz) {
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paineis = [...raiz.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const ativar = (i: number, foco = false) => {
      abas.forEach((a, k) => {
        const sel = k === i;
        a.setAttribute('aria-selected', String(sel));
        a.tabIndex = sel ? 0 : -1;
        paineis[k].hidden = !sel;
        paineis[k].classList.remove('desenha');
      });
      void paineis[i].offsetWidth; // reinicia a animação
      paineis[i].classList.add('desenha');
      if (foco) abas[i].focus();
    };

    abas.forEach((a, i) => {
      a.addEventListener('click', () => ativar(i));
      a.addEventListener('keydown', (e) => {
        const prox = ['ArrowDown', 'ArrowRight'].includes(e.key) ? 1 : ['ArrowUp', 'ArrowLeft'].includes(e.key) ? -1 : 0;
        if (prox) { e.preventDefault(); ativar((i + prox + abas.length) % abas.length, true); }
        if (e.key === 'Home') { e.preventDefault(); ativar(0, true); }
        if (e.key === 'End') { e.preventDefault(); ativar(abas.length - 1, true); }
      });
    });

    // Primeira planta desenha quando a seção aparece.
    const obs = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { obs.disconnect(); ativar(0); }
    }, { threshold: 0.3 });
    obs.observe(raiz);
  }
</script>
