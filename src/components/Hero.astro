---
import { getImage } from 'astro:assets';
import casinha from '../assets/brand/casinha.png';
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/whatsapp';

// A animação só amostra ~130px da imagem: uma versão WebP pequena basta.
const casinhaLeve = await getImage({ src: casinha, width: 280, format: 'webp' });
---
<section class="hero relative isolate overflow-hidden" aria-labelledby="hero-titulo">
  <div class="hero-fundo malha" aria-hidden="true"></div>
  <canvas class="hero-canvas" data-particulas data-src={casinhaLeve.src} aria-hidden="true"></canvas>

  <div class="wrap relative z-10 grid min-h-[100svh] content-end pb-14 pt-[44svh] lg:content-center lg:pt-28 lg:pb-20">
    <div class="max-w-[40rem] lg:max-w-[54%]">
      <h1 id="hero-titulo" class="hero-titulo">
        Transformamos ideias em projetos web.
      </h1>
      <p class="mt-6 max-w-[33rem] text-lg leading-relaxed text-nevoa-2">
        Sites institucionais, landing pages de alta conversão, sistemas web sob medida e aplicações completas.
        Tecnologia moderna, performance e design funcional para o seu negócio crescer no digital.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-acao">
          <Icon name="whatsapp" size={20} /> Pedir orçamento no WhatsApp
        </a>
        <a href="#servicos" class="btn-linha">Ver serviços</a>
      </div>
    </div>

    <p class="hero-legenda" data-legenda aria-hidden="true"></p>
  </div>
</section>

<style>
  .hero { background: radial-gradient(60rem 40rem at 72% 45%, color-mix(in srgb, var(--color-indigo) 85%, transparent), transparent 70%), var(--color-noite); }
  .hero-fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: radial-gradient(55rem 38rem at 70% 45%, #000 20%, transparent 75%);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .hero-titulo {
    font-size: clamp(2.1rem, 9vw, 4.7rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .hero-legenda {
    position: absolute;
    right: 2rem;
    bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #5f6c9e;
    display: none;
  }
  @media (min-width: 1024px) { .hero-legenda { display: block; } }
</style>

<script>
  import { iniciarParticulas } from '../lib/particulas';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-particulas]');
  if (canvas) iniciarParticulas(canvas, { legenda: document.querySelector<HTMLElement>('[data-legenda]') });
</script>
