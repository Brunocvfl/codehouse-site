---
// Imagem de um Projeto num dos perfis de src/lib/imagens.ts (capa, card, slide, texto).
// Sem imagem, mostra o símbolo </> no lugar, ocupando o mesmo espaço.
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import { opcoesDaImagem, type NomeDoPerfil } from '../lib/imagens';

type Atributos = Omit<HTMLAttributes<'img'>, 'src' | 'alt' | 'width' | 'height' | 'sizes' | 'srcset'>;
interface Props extends Atributos {
  perfil: NomeDoPerfil;
  src?: ImageMetadata;
  alt: string;
}
const { perfil, src, alt, ...atributos } = Astro.props;
---
{src ? (
  <Image src={src} alt={alt} {...opcoesDaImagem(perfil)} {...atributos} />
) : (
  <div class="sem-imagem" aria-hidden="true">{'</>'}</div>
)}

<style>
  .sem-imagem {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 2rem;
    color: rgb(86 180 224 / 0.6);
  }
</style>
