---
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/whatsapp';
---
<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener"
  aria-label="Conversar com a Code House no WhatsApp"
  class="fixed bottom-5 right-5 z-40 grid size-14 place-items-center rounded-full bg-chaves text-sobre-chaves shadow-[0_8px_24px_-6px_color-mix(in_srgb,var(--color-chaves)_55%,transparent)] transition-colors hover:bg-chaves-forte"
>
  <Icon name="whatsapp" size={28} />
</a>
