---
import CarrosselProjetos from './CarrosselProjetos.astro';
import Icon from './Icon.astro';
import { getProjetos } from '../lib/portfolio';
import { SITE } from '../lib/site';

const projetos = await getProjetos();
---
<section id="portfolio" class="relative overflow-x-clip border-t border-linha py-24 md:py-32" aria-labelledby="portfolio-titulo">
  <div class="wrap">
    <h2 id="portfolio-titulo" class="titulo-secao">Projetos</h2>

    {projetos.length > 0 ? (
      <div class="mt-12">
        <CarrosselProjetos projetos={projetos} />
      </div>
    ) : (
      <div class="vazio malha mt-12">
        <div class="relative max-w-xl">
          <p class="font-display text-xl font-medium">Estudos de caso em produção.</p>
          <p class="mt-3 text-nevoa-2">
            Estamos documentando os projetos para publicar aqui. Enquanto isso, os bastidores estão no Instagram.
          </p>
          <a href={SITE.instagramUrl} target="_blank" rel="noopener" class="btn-linha mt-7">
            <Icon name="instagram" size={18} /> Seguir @{SITE.instagram}
          </a>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .vazio { position: relative; padding: 2.5rem; border: 1px dashed var(--color-linha-forte); border-radius: 16px; background-color: var(--color-noite-2); }
  @media (min-width: 768px) { .vazio { padding: 3.5rem; } }
</style>
